# 复制成 .env 后按需修改。全部可选，不配也能跑。

# ---- 服务 ----
# APP_HOST=127.0.0.1
# APP_PORT=8000

# ---- 数据库 ----
# 默认是 server/portfolio.db（SQLite，文件型，不用装数据库）
# APP_DATABASE_URL=sqlite:///./portfolio.db

# ---- 联系表单 ----
# 每个 IP 每分钟最多提交次数
# APP_CONTACT_RATE_LIMIT=5/minute

# ---- 邮件通知（不配则只入库，不发信）----
# APP_SMTP_HOST=smtp.qq.com
# APP_SMTP_PORT=587
# APP_SMTP_USER=3638403983@qq.com
# APP_SMTP_PASSWORD=你的SMTP授权码
# APP_NOTIFY_EMAIL=3638403983@qq.com
